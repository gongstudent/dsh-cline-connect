{
  "name": "dsh-cline-connect",
  "version": "0.2.1",
  "description": "Self-contained Cline provider for dsh: registers the Cline gateway's free (cline-free/*) and ClinePass (cline-pass/*) models on the harness LLM seam, sending the x-client-type product-surface header that the gateway requires for free models. Single API key, no proxy process.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "llm-provider",
    "cline",
    "cline-free",
    "clinepass"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-credentials": ">=0.1.2-alpha.3",
    "@deepseek-ai/dsh-launch-environment": ">=0.1.2-alpha.3",
    "@deepseek-ai/dsh-llm": ">=0.1.2-alpha.3",
    "@deepseek-ai/dsh-timeout": ">=0.1.2-alpha.3",
    "@deepseek-ai/dsh-tools": ">=0.1.2-alpha.3",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
